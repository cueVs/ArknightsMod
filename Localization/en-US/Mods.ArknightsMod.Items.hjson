TragodiaDefault: {
	DisplayName: Tragodia Default
	Tooltip: ""
}

Tragodia: {
	DisplayName: Tragodia
	Tooltip: ""
}

BloodMushroom: {
	DisplayName: Blood Fungus
	Tooltip:
		'''
		Feast here, until you are the one being served.
		While carried, each enemy naturally spawned by the current environment has a 10% chance to be enveloped by Red Mist. Each kill raises its Originium Ingot value and empowers later Red Mist enemies.
		Dying resets the price.
		'''
}

FrostCrystalTree: {
	DisplayName: Frost Crystal Tree
	Tooltip:
		'''
		Such fine unmelted beauty, before the sun pierces the flesh.
		While carried: killing a weak enemy at full health +1 Originium Ingot value, killing a boss at full health +10, taking damage -5
		If the value hits zero or you die, it shatters: value is halved and locked forever
		'''
}

EchoCorn: {
	DisplayName: Echo Corn
	Tooltip:
		'''
		Every sweet nothing, crisp and full.
		While carried, talking to each different NPC raises its value (+1 per 5% happiness), once per NPC
		'''
}

FogRollingGrass: {
	DisplayName: Fog Rolling Grass
	Tooltip:
		'''
		Swept up in the mist, drifting further from soil and root.
		While carried, +1 value per 200m walked, up to 16
		'''
}

WaveSpray: {
	DisplayName: Sea Spray
	Tooltip:
		'''
		Nature makes the change, thought renders it, so living things may proudly claim their freedom.
		While carried in rain or snow, every 500m walked randomly -4 or +5 value; unchanged in clear weather
		Never below 0 or above 66
		'''
}

ProliferatingMoss: {
	DisplayName: Proliferating Moss
	Tooltip:
		'''
		Creeping over dirt, trees, dreams, growth.
		While carried, +1 value per other kind of natural collectible in your inventory
		'''
}

WitheredMossBall: {
	DisplayName: Withered Moss Ball
	Tooltip: Then rot, wither, despair, death.
}

BoardVine: {
	DisplayName: Board Vine
	Tooltip:
		'''
		Clings to its own kind, never letting go.
		While carried, +4 value per other kind of natural collectible in your inventory
		'''
}

HomesickFruit: {
	DisplayName: Homesick Fruit
	Tooltip:
		'''
		Blinded by praise, it started its own countdown with its own hands.
		While carried, -2 value per 200m walked
		Can be replanted in a qualifying spot (underside of grass/moss); it regains 2 value per in-game day, up to 32
		'''
}

GlowingTruffle: {
	DisplayName: Glowing Truffle
	Tooltip: If it isn't dug up and savored, it hardly deserves such an honor.
}

Vulcan_Weapon: {
	DisplayName: Vulcan_ Weapon
	Tooltip: ""
}

HellagurOdachi: {
	DisplayName: Hellagur's Odachi
	Tooltip:
		'''
		Lower health grants faster attacks, and attacks restore health
		“He is the General”
		'''
}

BlazeGreatsword: {
	DisplayName: Blaze's Chainsaw Greatsword
	Tooltip:
		'''
		Attacks every enemy it touches
		“Blood boils”
		'''
}

FiammettaHandCannon: {
	DisplayName: Fiammetta's Hand Cannon
	Tooltip: Fires shells into the sky to strike the target
}

SpecterBoneSaw: {
	DisplayName: Specter's Bone Saw
	Tooltip:
		'''
		Attacks every enemy it touches
		While held, raises max life by 10% and restores 2% of max life each second
		'''
}

ShiningStaff: {
	DisplayName: Shining's Staff
	Tooltip:
		'''
		Fires black-and-white Arts blades at enemies
		Skills provide limited healing, a personal barrier, and a defensive field
		'''
}

PassengerConductor: {
	DisplayName: Passenger's Electromagnetic Conductor
	Tooltip:
		'''
		Fires three-round bursts of non-homing orange-gold lightning through blocks, traveling about 2.5 visible screen widths
		Only a direct collision triggers the impact burst and chain, hitting up to 4 enemies
		Each jump loses 15% damage and briefly slows ordinary enemies; Skill 3 deploys a skyborne thunderstorm
		'''
}

LeiziStaff: {
	DisplayName: Leizi's Thunder Staff
	Tooltip:
		'''
		Fires non-homing scarlet-orange and gold lightning through blocks
		A direct hit triggers an impact burst and chains between up to 4 enemies
		Each jump loses 15% damage and briefly slows ordinary enemies
		Can be crafted into Passenger's Electromagnetic Conductor
		'''
}

RopeBodySet.Tooltip: ""
RopeHeadSet.Tooltip: ""
RopeLegsSet.Tooltip: ""

UtageKatana: {
	DisplayName: Utage's Katana
	Tooltip:
		'''
		Swings faster at low life; valid hits restore a small amount of life
		Cuts with deep violet trails and pale lilac edges
		'''
}

RedDagger: {
	DisplayName: Projekt Red's Dagger
	Tooltip:
		'''
		Hold attack to rapidly cut a very short area in front of you with red-black slashes
		Each slash hits an enemy only once and cannot damage through walls
		Rapid deployment: switch from another hotbar weapon, teleport or dash to burst and gain attack speed for 5 seconds; 5-second cooldown
		Teleport tools may be used within 1.5 seconds of switching from the dagger; carrying it alone does not qualify
		Fast landings also trigger it; walking, running, small hops and sustained flight do not. Switching cannot reset cooldown
		'''
}
