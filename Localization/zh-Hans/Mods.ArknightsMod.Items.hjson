WarfarinStaff: {
	DisplayName: 华法琳的血浆法杖
	Tooltip:
		'''
		发射血液穿透敌人
		技能期间为召唤物提供强力增益
		'''
}

IndigoStaff: {
	DisplayName: 深靛的灯塔法杖
	Tooltip:
		'''
		发射追踪水光，停火时储存至多三枚，随下次攻击一同释放
		以灯塔之光疾射，以淡紫潮汐束缚敌人
		'''
}

HarmonieStaff: {
	DisplayName: 和弦的协奏法杖
	Tooltip:
		'''
		发射追踪音符，停火时储存至多三枚，随下次攻击一同奏响
		以流动乐谱与共鸣水域淹没敌人
		'''
}
