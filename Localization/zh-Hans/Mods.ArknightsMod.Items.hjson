// RopeLegsSet.Tooltip: ""

UtageKatana: {
	DisplayName: 宴的太刀
	Tooltip:
		'''
		生命值越低，挥刀越快；有效命中可以回复少量生命
		以深紫刀幕和淡紫刃光斩击敌人
		'''
}

RedDagger: {
	DisplayName: 红的匕首
	Tooltip:
		'''
		进行极高速的近战攻击
		快速传送或冲刺时触发“再部署”
		手之时提供移速与跳跃提升
		'''
}

HoolheyakWindArts: {
	DisplayName: 霍尔海雅的御风羽饰
	Tooltip:
		'''
		抬手释放风弹，命中后形成追踪风旋
		吸附并卷起小怪，无法卷起首领
		'''
}

SussurroStaff: {
	DisplayName: 苏苏洛的医疗法杖
	Tooltip:
		'''
		发射高速治疗光线伤害敌人
		攻击多次可进行额外治疗
		右键释放强力追踪的治疗蝴蝶
		'''
}

EbenholzStaff: {
	DisplayName: 黑键的奏鸣法杖
	Tooltip:
		'''
		释放追踪黑色奏鸣块
		可以储存多枚残响一起释放
		'''
}

EthanYoyo: {
	DisplayName: 伊桑的悠悠球
	Tooltip:
		'''
		小概率束缚住小怪
		使用期间降低玩家仇恨值
		并有10%的概率闪避伤害
		'''
}

HornGrenadeLauncher: {
	DisplayName: 号角的榴弹炮盾
	Tooltip:
		'''
		手持时自动举盾，冷却结束后自动恢复；左键始终发射榴弹
		成功格挡后5秒内，下一次炮击伤害翻倍
		'''
}

